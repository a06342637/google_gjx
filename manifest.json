{
  "manifest_version": 3,
  "name": "工具箱",
  "version": "1.6.4",
  "description": "本地 2FA、密码和美国英文姓名生成工具。",
  "action": {
    "default_title": "工具箱",
    "default_popup": "popup.html",
    "default_icon": "icons/icon32.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://randomuser.me/*"
  ]
}
